# Copy to .env (production / docker compose) or .env.local (npm run dev) and fill in.

# App URL (used for NextAuth callbacks, Stripe redirects and links in emails)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=            # openssl rand -base64 32

# Firebase (Firestore + Storage) - use ONE of the credential options
GOOGLE_APPLICATION_CREDENTIALS=./secrets/baanlomnow-firebase.json
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
FIREBASE_PROJECT_ID=baanlomnow-3501a
FIREBASE_STORAGE_BUCKET=baanlomnow-3501a.firebasestorage.app
# Firestore database (asia-southeast1); this is also the default in code
FIRESTORE_DATABASE_ID=baanlomnow-sg
# Build-time; only needed if the bucket name differs from the default above
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=baanlomnow-3501a.firebasestorage.app

# LINE Login + Messaging API
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ADMIN_EMAIL=
ADMIN_PHONE=
