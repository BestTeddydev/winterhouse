rules_version = '2';
// Uploads go through the server (Admin SDK) and are read via download-token URLs,
// which work regardless of these rules. Only static site assets are publicly readable.
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{allPaths=**} {
      allow read: if true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
