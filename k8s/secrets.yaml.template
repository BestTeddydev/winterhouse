apiVersion: v1
kind: Secret
metadata:
  name: baanlomnow-secrets
  namespace: baanlomnow
type: Opaque
stringData:
  # MongoDB Configuration
  MONGODB_URI: "mongodb://mongodb-service:27017/baanlomnow"
  DATABASE_URL: "mongodb://mongodb-service:27017/baanlomnow"
  MONGODB_ROOT_PASSWORD: "CHANGE_ME_TO_SECURE_PASSWORD"
  
  # Application URLs
  NEXT_PUBLIC_APP_URL: "https://baanlomnow.com"
  NEXTAUTH_URL: "https://baanlomnow.com"
  NEXTAUTH_SECRET: "CHANGE_ME_TO_SECURE_SECRET"
  
  # Google Cloud Configuration
  GOOGLE_CLOUD_PROJECT_ID: "your-project-id"
  GOOGLE_CLOUD_BUCKET_NAME: "your-bucket-name"
  
  # Stripe Configuration (Replace with your actual keys)
  STRIPE_SECRET_KEY: "sk_live_YOUR_STRIPE_SECRET_KEY"
  STRIPE_PUBLIC_KEY: "pk_live_YOUR_STRIPE_PUBLIC_KEY"
  STRIPE_WEBHOOK_SECRET: "whsec_YOUR_WEBHOOK_SECRET"
  
  # Resend Configuration (Replace with your actual key)
  RESEND_API_KEY: "re_YOUR_RESEND_API_KEY"
  ADMIN_EMAIL: "admin@example.com"
  ADMIN_PHONE: "0123456789"
  RESEND_FROM_EMAIL: "noreply@example.com"
  
  # LINE Configuration (Replace with your actual credentials)
  LINE_CHANNEL_ID: "YOUR_LINE_CHANNEL_ID"
  LINE_CHANNEL_SECRET: "YOUR_LINE_CHANNEL_SECRET"
  LINE_CHANNEL_ACCESS_TOKEN: "YOUR_LINE_CHANNEL_ACCESS_TOKEN"
  LINE_ADMIN_USER_ID: "YOUR_LINE_ADMIN_USER_ID"
