# 🔐 Environment Variables สำหรับ Baanlomnow
# คัดลอกไฟล์นี้เป็น .env และใส่ข้อมูลจริง

# ===========================================
# 🗄️ DATABASE CONFIGURATION
# ===========================================
MONGODB_URI=mongodb://mongodb-service:27017/baanlomnow
MONGODB_ROOT_PASSWORD=your-mongodb-password

# ===========================================
# 🔑 NEXTAUTH CONFIGURATION
# ===========================================
NEXTAUTH_URL=https://baanlomnow.com
NEXTAUTH_SECRET=your-nextauth-secret-here

# ===========================================
# 🌐 GOOGLE CLOUD CONFIGURATION
# ===========================================
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_STORAGE_BUCKET=your-bucket-name

# ===========================================
# 💳 PAYMENT GATEWAY CONFIGURATION
# ===========================================

# Stripe Payment Gateway
STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# ===========================================
# 📧 EMAIL SERVICE CONFIGURATION
# ===========================================
RESEND_API_KEY=re_your-resend-api-key

# ===========================================
# 📱 LINE INTEGRATION CONFIGURATION
# ===========================================

# LINE Login
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_ADMIN_USER_ID=your-line-admin-user-id

# ===========================================
# 🌐 APPLICATION CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL=https://baanlomnow.com

# ===========================================
# 🔧 DEVELOPMENT CONFIGURATION
# ===========================================
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0
